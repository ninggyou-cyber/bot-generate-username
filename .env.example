BOT_TOKEN=123456789:AAxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
OWNER_ID=123456789
DELAY_MS=800

# Akun Telegram untuk verifikasi username (dari my.telegram.org)
TG_API_ID=12345678
TG_API_HASH=abcdef1234567890abcdef1234567890

# Session string Telegram (isi dari session.txt setelah `npm run login`).
# Di lokal cukup pakai file session.txt. Di Railway/hosting, set var ini.
# JANGAN taruh session asli di file ini — file ini ikut ke GitHub!
TG_SESSION=isi_dengan_string_dari_session.txt

# Rotasi banyak akun (opsional, tapi sangat disarankan biar tidak cepat kena limit).
# Tambahkan akun ke-2, ke-3, dst. Bot otomatis ganti akun saat satu kena FloodWait.
# TG_SESSION_2=string_session_akun_kedua
# TG_SESSION_3=string_session_akun_ketiga

# Jeda antar-cek di Fase 2 (ms). Lebih besar = lebih aman dari limit Telegram, tapi lebih lambat.
TG_CHECK_DELAY_MS=1200

# Maks waktu auto-tunggu per username saat SEMUA akun lagi limit (ms).
# Lewat ini username masuk "perlu cek ulang". Default 300000 (5 menit).
TG_MAX_WAIT_MS=300000

# Opsional — hanya diperlukan jika ingin fitur beli stars/premium/ads via Robynhood
# ROBYNHOOD_API_KEY=your_robynhood_api_key_here
