BOT_TOKEN=123456789:AAxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
OWNER_ID=123456789
DELAY_MS=500

# Akun Telegram untuk verifikasi username (dari my.telegram.org)
TG_API_ID=12345678
TG_API_HASH=abcdef1234567890abcdef1234567890

# Session string Telegram (isi dari session.txt setelah `npm run login`).
# Di lokal cukup pakai file session.txt. Di Railway/hosting, set var ini.
TG_SESSION=

# Jeda antar-cek di Fase 2 (ms). Lebih besar = lebih aman dari limit Telegram, tapi lebih lambat.
# Default 800. Naikkan ke 1200-1500 kalau sering kena "perlu cek ulang".
TG_CHECK_DELAY_MS=800

# Opsional — hanya diperlukan jika ingin fitur beli stars/premium/ads via Robynhood
# ROBYNHOOD_API_KEY=your_robynhood_api_key_here
